<Window x:Class="AthleticsCertificateMaker.GenerateCertificateApp.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting Generate Certificate App"
        Width="560"
        Height="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="Assets/AppIcon.ico">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6F4FF" Offset="0" />
            <GradientStop Color="#E08FA8" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Background="Transparent" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="CertificateTemplate.png"
                   Stretch="Uniform"
                   Margin="0,0,16,0" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Background="Transparent">
                <TextBlock Text="Generate Certificate App" FontSize="26" FontWeight="SemiBold" Background="Transparent" />
                <TextBlock x:Name="VersionText" Margin="0,8,0,0" Opacity="0.75" FontSize="14" Background="Transparent" />
                <TextBlock Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           Opacity="0.85"
                           Background="Transparent"
                           Text="Create certificates quickly from participant data and your configured template." />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   HorizontalAlignment="Right"
                   Margin="0,10,0,0"
                   Opacity="0.55"
                   Background="Transparent"
                   Text="Loading..." />
    </Grid>
</Window>