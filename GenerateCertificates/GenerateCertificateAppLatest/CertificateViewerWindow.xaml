<Window x:Class="AthleticsCertificateMaker.GenerateCertificateApp.CertificateViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Certificate Viewer"
        Height="720"
        Width="980"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/AppIcon.ico">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6F4FF" Offset="0" />
            <GradientStop Color="#E08FA8" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <TextBlock x:Name="FileNameText"
                   Grid.Row="1"
                   Margin="0,0,0,10"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <!-- Replace fixed Name/Distance +/- nudge buttons with a target selector menu and Start/Back/Next/End nudge controls -->
        <StackPanel x:Name="NudgePanel" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Row="0">
			<Button Content="← Back" Width="90" Click="Back_Click" />
            <TextBlock Text="Property: " VerticalAlignment="Center" Margin="20,0,10,0" />
            <ComboBox x:Name="NudgeTargetCombo" Width="160" SelectedIndex="0" Margin="0,0,12,0">
                <ComboBoxItem Content="Name Label" Tag="Name.LabelY" />
                <ComboBoxItem Content="Name Value" Tag="Name.ValueY" />
                <ComboBoxItem Content="Distance Label" Tag="Distance.LabelY" />
                <ComboBoxItem Content="Distance Value" Tag="Distance.ValueY" />
            </ComboBox>

            <Button Content="Back 50" Width="60" Margin="0,0,6,0" Tag="-50" Click="NudgeButton_Click" />
            <Button Content="Back 5" Width="60" Margin="0,0,6,0" Tag="-5" Click="NudgeButton_Click" />
            <Button Content="Fwd 5" Width="60" Margin="0,0,6,0" Tag="5" Click="NudgeButton_Click" />
            <Button Content="Fwd 50" Width="60" Tag="50" Click="NudgeButton_Click" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Background="#11FFFFFF">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Image x:Name="CertificateImage" Stretch="Uniform" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>