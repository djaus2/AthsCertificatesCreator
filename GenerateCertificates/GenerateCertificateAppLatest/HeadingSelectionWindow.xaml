<Window x:Class="AthleticsCertificateMaker.GenerateCertificateApp.HeadingSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Event"
        Height="440"
        Width="520"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/AppIcon.ico">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6F4FF" Offset="0" />
            <GradientStop Color="#E08FA8" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Select Event" FontWeight="SemiBold" Margin="0,0,0,8" />

        <ListBox x:Name="HeadingsList"
                 Grid.Row="1"
                 MinHeight="280"
                 Margin="0,0,0,10"
                 SelectionChanged="HeadingsList_SelectionChanged" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>